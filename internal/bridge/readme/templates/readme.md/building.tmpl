{{- else}}
{{- /*
     No hand-written section: derive the entry points from the CI DAG itself,
     so the README can never drift from what the pipeline actually runs. A goal
     node is exactly a `make <name>` target — pf-ci renders one workflow file
     per goal, and m6e exposes one launcher per goal.

     Three guards are load-bearing. The outer `with` skips a project with no CI
     namespace at all — `pf` coerces a miss to "", which `range` cannot iterate.
     `if $node` skips a NULL node (the shape a bare `ci:` override leaves
     behind), which would otherwise abort the render with a nil-pointer error.
     `with .description` skips a goal that has none, which would otherwise print
     a literal <no value>.

     Ranging a map iterates in sorted key order, so the list is stable with no
     sort helper. Lines accumulate into $goals first because the heading must
     not print for a project that has neither goals nor build docs.
*/ -}}
{{- $goals := "" -}}
{{- with pf "org.projectfile.ci.nodes" -}}
{{- range $name, $node := . -}}
{{- if $node -}}{{- if $node.goal -}}
{{- $line := printf "- `make %s`" $name -}}
{{- with $node.description -}}{{- $line = printf "%s — %s" $line . -}}{{- end -}}
{{- $goals = printf "%s%s\n" $goals $line -}}
{{- end -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- if or buildLinks $goals}}
## {{t "building.title"}}
{{- with buildLinks}}

{{range .}}- [{{.Label}}]({{.Filename}})
{{end -}}
{{- end}}
{{- with $goals}}

{{t "building.goals"}}

{{.}}
{{- end}}
{{- end}}
{{- end}}
