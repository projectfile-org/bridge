{{if eq . "pull-requests"}}Pull request’и{{else if eq . "commit-messages"}}Повідомлення комітів{{else if eq . "discussions"}}Обговорення{{else if eq . "bug-reports"}}Звіти про вади{{else if eq . "code-review"}}Рецензування коду{{else if eq . "security-reports"}}Звіти про безпеку{{else if eq . "code"}}Код{{else if eq . "documentation"}}Документація{{else if eq . "code-comments"}}Коментарі в коді{{else if eq . "translations"}}Переклади{{else if eq . "prose"}}Проза{{else if eq . "images"}}Зображення{{else if eq . "audio"}}Аудіо{{else if eq . "video"}}Відео{{else if eq . "refactoring"}}Рефакторинг{{else if eq . "bug-fixing"}}Виправлення вад{{else if eq . "tests"}}Тести{{else if eq . "grammar-tools"}}Граматичні інструменти{{else if eq . "merges"}}Злиття{{else if eq . "releases"}}Випуски{{else if eq . "triage"}}Сортування задач{{else}}{{.}}{{end}}
