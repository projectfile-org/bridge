{{if eq . "pull-requests"}}Pull requests{{else if eq . "commit-messages"}}Commit messages{{else if eq . "discussions"}}Discussions{{else if eq . "bug-reports"}}Bug reports{{else if eq . "code-review"}}Code review{{else if eq . "security-reports"}}Security reports{{else if eq . "code"}}Code{{else if eq . "documentation"}}Documentation{{else if eq . "code-comments"}}Code comments{{else if eq . "translations"}}Translations{{else if eq . "prose"}}Prose{{else if eq . "images"}}Images{{else if eq . "audio"}}Audio{{else if eq . "video"}}Video{{else if eq . "refactoring"}}Refactoring{{else if eq . "bug-fixing"}}Bug fixing{{else if eq . "tests"}}Tests{{else if eq . "grammar-tools"}}Grammar tools{{else if eq . "merges"}}Merges{{else if eq . "releases"}}Releases{{else if eq . "triage"}}Triage{{else}}{{.}}{{end}}
{{- end -}}

